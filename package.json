{
  "name": "dsh-compaction-sticky-window",
  "version": "0.6.1",
  "description": "Replaces the summarizing context compactor with a handoff note the model writes itself and a fresh window that keeps only the system prompt, the note, and the current turn.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "presets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/note.test.mjs test/engine.integration.mjs",
    "sync-preset": "node scripts/sync-preset.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "compaction",
    "context",
    "window",
    "sticky-note"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/sticky-window.patch.yml"
      ]
    }
  }
}

