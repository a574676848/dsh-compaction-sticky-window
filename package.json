{
  "name": "dsh-compaction-sticky-window",
  "version": "0.9.0",
  "description": "Replaces the summarizing context compactor with a handoff note the model writes itself and a fresh window that keeps only the system prompt, the note, and the current turn.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "presets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/note.test.mjs test/engine.integration.mjs test/preset-sync.test.mjs",
    "sync-preset": "node scripts/sync-preset.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "compaction",
    "context",
    "window",
    "sticky-note"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a574676848/dsh-compaction-sticky-window.git"
  },
  "homepage": "https://github.com/a574676848/dsh-compaction-sticky-window#readme",
  "bugs": {
    "url": "https://github.com/a574676848/dsh-compaction-sticky-window/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/sticky-window.patch.yml"
      ]
    }
  }
}